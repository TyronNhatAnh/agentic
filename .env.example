# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Claude CLI (must be installed and authenticated separately: `claude login`)
CLAUDE_BIN=claude
CLAUDE_TIMEOUT=300

# Storage
AGENTIC_DB=agentic.db

# Context budgets
MAX_INPUT_CHARS=16000
MAX_CONTEXT_CHARS=8000
DEV_CONTEXT_CHARS=16000
BRAIN_HISTORY_BUDGET_CHARS=60000
BRAIN_HISTORY_MSG_CAP_CHARS=12000

# GitHub (MVP integration)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
GITHUB_USERNAME=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=

# Logging
LOG_LEVEL=INFO

GRAFANA_API_KEY_STAG=
GRAFANA_STAG_BASE_URL=https://grafana-nonprod.gogo.tech

GRAFANA_API_KEY_PROD=
GRAFANA_PROD_BASE_URL=https://grafana-kr.gogo.tech/

GRAFANA_STAG_LOKI_UID=loki
GRAFANA_PROD_LOKI_UID=loki

AGENTIC_SERVICES_JSON=services.json

NOTION_TOKEN=
NOTION_BASE_URL=https://app.notion.com/p/gogox
NOTION_PAGE_ID=36bf54d1149880bc966afc46ca018116
NOTION_ROOT_PAGE="Docs"
# Notion API version pinned by the connector (integrations/notion.py).
NOTION_VERSION=2022-06-28

# --- da-api revamp tier (channel-routed, docs → Notion only) ---
# Slack channel ID (Cxxxx) that switches the brain to revamp/read-only mode and
# enables the `revamp <scope>` pipeline. Empty = revamp tier off everywhere.
REVAMP_CHANNEL_ID=
# Local path to the legacy da-api (Ruby) repo the archaeologist reads. Must be
# readable by the bot process.
REVAMP_LEGACY_REPO=
# Max modules analysed per `revamp <scope>` run (backstop; truncation is reported).
REVAMP_MODULE_CAP=40
# Registry service name (services.json) of the rewrite target repo — where impl/PR
# work lands once the project moves past the analysis phase.
REVAMP_TARGET_SERVICE=da-api-v2
# Read-only MariaDB the archaeologist queries for the CURRENT schema + config-in-DB
# values (schema.rb is stale; live introspection is the source of truth). Point at a
# LOCAL staging clone with a SELECT-only grant — never prod. Empty host = db_query off.
REVAMP_DB_HOST=127.0.0.1
REVAMP_DB_PORT=3306
REVAMP_DB_USER=
REVAMP_DB_PASSWORD=
REVAMP_DB_NAME=
REVAMP_DB_ROW_CAP=200
REVAMP_DB_TIMEOUT_S=10
# Path to the canonical migrations (common-services repo, NOT legacy da-api). Added
# to the archaeologist's add_dirs so it Reads the real migration history.
REVAMP_COMMON_MIGRATIONS_DIR=