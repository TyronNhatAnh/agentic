# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Claude CLI (must be installed and authenticated separately: `claude login`)
CLAUDE_BIN=claude
CLAUDE_TIMEOUT=300

# Storage
AGENTIC_DB=agentic.db

# Context budgets
MAX_INPUT_CHARS=16000
MAX_CONTEXT_CHARS=8000
DEV_CONTEXT_CHARS=16000
BRAIN_HISTORY_BUDGET_CHARS=60000
BRAIN_HISTORY_MSG_CAP_CHARS=12000

# GitHub (MVP integration)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
GITHUB_USERNAME=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=

# Logging
LOG_LEVEL=INFO

GRAFANA_API_KEY_STAG=
GRAFANA_STAG_BASE_URL=https://grafana-nonprod.gogo.tech

GRAFANA_API_KEY_PROD=
GRAFANA_PROD_BASE_URL=https://grafana-kr.gogo.tech/

GRAFANA_STAG_LOKI_UID=loki
GRAFANA_PROD_LOKI_UID=loki

AGENTIC_SERVICES_JSON=services.json
