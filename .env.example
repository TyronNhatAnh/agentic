# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Claude CLI (must be installed and authenticated separately: `claude login`)
CLAUDE_BIN=claude
CLAUDE_TIMEOUT=300

# Storage
AGENTIC_DB=agentic.db

# Context budgets
MAX_INPUT_CHARS=16000
MAX_CONTEXT_CHARS=8000
DEV_CONTEXT_CHARS=16000
BRAIN_HISTORY_BUDGET_CHARS=60000
BRAIN_HISTORY_MSG_CAP_CHARS=12000

# Per-turn circuit breakers (0 disables a cap). brain_timeout_s is a wall-clock
# deadline that discards the hung session; max_turns/max_budget_usd are SDK-native
# caps that stop a runaway agent loop before it burns time/cost.
BRAIN_TIMEOUT_S=600
BRAIN_MAX_TURNS=0
BRAIN_MAX_BUDGET_USD=0

# GitHub (MVP integration)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
GITHUB_USERNAME=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=

# Logging
LOG_LEVEL=INFO

# Service-account basic-auth password (devops-issued) — the sole Grafana auth.
# One credential authenticates BOTH instances (nonprod + prod-kr).
GRAFANA_SA_KR=
GRAFANA_SA_USER=grafana-sa-kr

GRAFANA_STAG_BASE_URL=https://grafana-nonprod.gogo.tech
GRAFANA_PROD_BASE_URL=https://grafana-kr.gogo.tech/

GRAFANA_STAG_LOKI_UID=loki
GRAFANA_PROD_LOKI_UID=loki

AGENTIC_SERVICES_JSON=services.json

# --- Hourly server-health monitor (src/agentic/monitor.py) ---
# Off by default. Set MONITOR_ENABLED=true AND MONITOR_CHANNEL to turn it on.
MONITOR_ENABLED=false
# Slack channel for the "vnth-bot" digest — prefer the channel ID (Cxxxxxxxx);
# the bot must be invited to it.
MONITOR_CHANNEL=
MONITOR_INTERVAL_S=3600
MONITOR_ENV=prod
MONITOR_WINDOW=1h
# Empty = every registered service with a loki_selector. Else CSV of service names.
MONITOR_SERVICES=
# A service crossing this many 5xx/crash lines / window is flagged 🔴.
MONITOR_ERROR_THRESHOLD=5
# CSV of `name=url` (or bare url) endpoints to GET each cycle. Empty = skip health checks.
MONITOR_HEALTH_URLS=
# false = post only when something is notable; true = post a digest every cycle.
MONITOR_ALWAYS_POST=false

# Internal integration token. The integration must be shared on each page you
# want the bot to read/update/delete (else Notion 404 → NOT_FOUND).
NOTION_TOKEN=
# Workspace reference only — NOT read by code. notion_get_page/update/delete take
# a page URL or id directly, so accessing a page needs no configured root.
NOTION_BASE_URL=https://app.notion.com/p/gogox
# Default PARENT page for notion_create_page when the caller doesn't pass `parent`.
# Only used when creating a new page; irrelevant to read/update/delete.
NOTION_PAGE_ID=36bf54d1149880bc966afc46ca018116
# Notion API version pinned by the connector (integrations/notion.py).
NOTION_VERSION=2022-06-28

# --- staging DB introspection (the db_query tool) ---
# Read-only DB access runs through ggx-kr-order-service's debug-query admin API
# (TEMPORARY, staging only — the staging DB sits behind VPN and is unreachable from
# the bot host). One read-only SELECT/WITH/SHOW/DESCRIBE/EXPLAIN per call against the
# read replica. Empty base URL or token = db_query off. The endpoint only exists when
# that service runs non-prod — never point at prod.
ORDER_DEBUG_BASE_URL=
# Admin accessToken (role AdminUser) — same auth as the order-service admin panel.
ORDER_DEBUG_ADMIN_TOKEN=
# Server enforces LIMIT 1000 / 15s; these client bounds keep the transcript small
# and the HTTP timeout above the server's query timeout. (Shared by staging + prod.)
ORDER_DEBUG_ROW_CAP=200
ORDER_DEBUG_TIMEOUT_S=20

# --- PRODUCTION DB introspection (the db_query_prod tool) ---
# Same debug endpoint on the PROD host, backed by a physical read replica. Hits
# REAL customer PII and is audit-logged, so db_query_prod is in CONFIRM_TOOLS —
# it always asks for a Slack confirm button before running. Empty = tool off.
# Use a GENUINE prod AdminUser accessToken (prod admin-panel login); it expires,
# refresh on 401/403 (a long-lived service token is still being set up).
ORDER_DEBUG_PROD_BASE_URL=
ORDER_DEBUG_PROD_ADMIN_TOKEN=
# Auto-login fallback (used only when ORDER_DEBUG_PROD_ADMIN_TOKEN is empty): the
# bot POSTs the admin manual-login form (fields email + pwd) and reuses the
# returned `access_token` cookie, re-logging in on 401/403 — no manual token copy.
# The login host must match the DB env's gateway: a business-STAGING login mints a
# staging token that a PROD query gateway will reject. Point it at the prod
# business-admin login for prod DB access.
ORDER_DEBUG_PROD_BASE_URL_LOGIN=
ORDER_DEBUG_PROD_BASE_EMAIL=
ORDER_DEBUG_PROD_BASE_PASS=