# Jira (optional, post-MVP)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=

# Linear (optional, post-MVP)
LINEAR_API_KEY=
LINEAR_DEFAULT_TEAM_ID=

# Logging
LOG_LEVEL=INFO
